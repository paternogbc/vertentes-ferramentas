# Opções do blogdown para este projeto
options(
  # Versão do Hugo usada localmente (a mesma do netlify.toml)
  blogdown.hugo.version = "0.158.0",
  # O conteúdo é .md puro: não há nada para "knitar"
  blogdown.method = "markdown",
  blogdown.knit.on_save = FALSE,
  blogdown.serve_site.startup = FALSE,
  blogdown.ext = ".md",
  blogdown.subdir = "ferramentas"
)

# Função auxiliar: nova_ferramenta()
if (file.exists("R/nova_ferramenta.R")) source("R/nova_ferramenta.R")
